# Include only inside an existing, inspected HTTPS virtual host.
# Verify this path is unused. Preserve the site's other routes and certificate.
location = /horserace {
    return 308 /horserace/;
}
location ^~ /horserace/ {
    client_max_body_size 16k;
    proxy_pass http://127.0.0.1:8770/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
}
