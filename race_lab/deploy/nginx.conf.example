# Add a separate virtual host; preserve all existing Pick'em configuration.
# Replace horses.example.com with the chosen domain. Configure its DNS and TLS
# using the droplet's existing certificate management before accepting sign-ins.
server {
    listen 80;
    server_name horses.example.com;
    client_max_body_size 16k;
    location / {
        proxy_pass http://127.0.0.1:8770;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
