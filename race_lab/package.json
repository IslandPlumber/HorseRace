{
  "name": "horserace-race-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local data-driven race test using the reusable HorseRace cast",
  "scripts": {
    "start": "python ../serve_preview.py",
    "test": "node --test race-core.test.js track.test.js audio-plan.test.js gait.test.js race-betting.test.js live-playback.test.js server/game.test.js server/betting.test.js server/race-simulation.test.js server/powers.test.js server/workshop.test.js server/live-simulation.test.js server/live-powers.test.js server/special-powers.test.js",
    "test:assets": "node verify-assets.mjs",
    "test:browser": "node verify-browser.mjs",
    "build": "node build-standalone.mjs",
    "record:demo": "node record-demo.mjs",
    "test:circuit": "node verify-circuit.mjs",
    "build:site": "node build-site.mjs",
    "test:audio": "node verify-audio.mjs",
    "start:multiplayer": "node server/start.js",
    "test:multiplayer": "node verify-multiplayer.mjs",
    "test:slips": "node verify-slips.mjs",
    "test:live-sound": "node verify-live-sound.mjs",
    "test:refinements": "node verify-refinements.mjs",
    "test:resources": "node verify-resources.mjs",
    "test:training-balance": "node analyze-training.mjs",
    "test:training": "node verify-training.mjs",
    "test:betting": "node verify-betting.mjs",
    "test:powers": "node verify-powers.mjs",
    "test:workshop": "node verify-workshop.mjs",
    "test:power-sound": "node verify-power-sound.mjs",
    "test:special-powers": "node verify-special-powers.mjs",
    "test:manual-powers": "node verify-manual-powers.mjs",
    "test:smoothness": "node verify-smoothness.mjs",
    "prepare:power-audio": "node prepare-power-audio.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "esbuild": "0.25.11"
  }
}
